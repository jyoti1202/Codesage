# ============================================================
# CodeSage — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Required ─────────────────────────────────────────────────
# Your Anthropic API key — get one at https://console.anthropic.com
GEMINI_API_KEY=AIzaSyD9blWAualzAfqs-4MTmpXFtDyJSnq9y7k

# ── Optional ─────────────────────────────────────────────────
# Override the default model (default: claude-sonnet-4-20250514)
# CODESAGE_MODEL=claude-sonnet-4-20250514

# Maximum tokens per agent response (default: 4096)
# CODESAGE_MAX_TOKENS=4096

# Maximum agentic loop iterations before giving up (default: 10)
# CODESAGE_MAX_ITERATIONS=10

# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
# LOG_LEVEL=INFO
